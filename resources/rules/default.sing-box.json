{
    "dns": {
        "servers": [
            {
                "type": "local",
                "tag": "local"
            },
            {
                "type": "https",
                "tag": "remote",
                "server": "cloudflare-dns.com",
                "path": "/dns-query",
                "detour": "节点选择",
                "domain_resolver": "local"
            },
            {
                "type": "https",
                "tag": "cn",
                "server": "dns.alidns.com",
                "path": "/dns-query",
                "domain_resolver": "local"
            },
            {
                "type": "fakeip",
                "tag": "fakeip",
                "inet4_range": "198.18.0.0/15",
                "inet6_range": "fc00::/18"
            }
        ],
        "rules": [
            {
                "domain_suffix": [
                    ".lan",
                    ".local",
                    ".localhost"
                ],
                "action": "route",
                "server": "local"
            },
            {
                "domain_regex": [
                    "^time\\..+\\.com$",
                    "^ntp\\..+\\.com$"
                ],
                "action": "route",
                "server": "local"
            },
            {
                "rule_set": [
                    "geosite-private",
                    "geosite-cn",
                    "geosite-icloud",
                    "geosite-apple"
                ],
                "action": "route",
                "server": "cn"
            },
            {
                "query_type": [
                    "A",
                    "AAAA"
                ],
                "action": "route",
                "server": "fakeip"
            },
            {
                "rule_set": [
                    "geosite-google",
                    "geosite-gfw",
                    "geosite-tld-!cn",
                    "geosite-geolocation-!cn"
                ],
                "action": "route",
                "server": "remote"
            }
        ],
        "final": "remote",
        "independent_cache": true
    },
    "inbounds": [
        {
            "tag": "tun-in",
            "type": "tun",
            "address": [
                "172.19.0.1/30",
                "2001:0470:f9da:fdfa::1/64"
            ],
            "auto_route": true,
            "mtu": 9000,
            "stack": "system",
            "strict_route": true,
            "route_exclude_address_set": ["geoip-cn"]
        },
        {
            "tag": "socks-in",
            "type": "socks",
            "listen": "127.0.0.1",
            "listen_port": 2333,
            "users": []
        },
        {
            "tag": "mixed-in",
            "type": "mixed",
            "listen": "127.0.0.1",
            "listen_port": 2334,
            "users": []
        }
    ],
    "outbounds": [
        {
            "tag": "DIRECT",
            "type": "direct",
            "domain_resolver": {
                "server": "local"
            }
        },
        {
            "tag": "节点选择",
            "type": "selector",
            "interrupt_exist_connections": true,
            "outbounds": [
                "自动选择"
            ]
        },
        {
            "tag": "自动选择",
            "type": "urltest",
            "url": "https://www.gstatic.com/generate_204",
            "interval": "10m",
            "tolerance": 50,
            "idle_timeout": "30m",
            "interrupt_exist_connections": false,
            "outbounds": []
        }
    ],
    "route": {
        "rules": [
            {
                "action": "sniff"
            },
            {
                "protocol": "dns",
                "action": "hijack-dns"
            },
            {
                "rule_set": [
                    "geosite-category-ads-all"
                ],
                "action": "reject",
                "method": "default",
                "no_drop": false
            },
            {
                "domain": [
                    "www.clarity.ms",
                    "c.clarity.ms",
                    "clash.razord.top",
                    "yacd.haishan.me"
                ],
                "action": "route",
                "outbound": "DIRECT"
            },
            {
                "domain_suffix": [
                    ".lan",
                    ".local"
                ],
                "action": "route",
                "outbound": "DIRECT"
            },
            {
                "ip_is_private": true,
                "action": "route",
                "outbound": "DIRECT"
            },
            {
                "clash_mode": "关闭代理",
                "action": "route",
                "outbound": "DIRECT"
            },
            {
                "clash_mode": "全局代理",
                "action": "route",
                "outbound": "节点选择"
            },
            {
                "ip_cidr": [
                    "198.18.0.0/15",
                    "fc00::/18"
                ],
                "action": "route",
                "outbound": "节点选择"
            },
            {
                "rule_set": [
                    "geosite-private",
                    "geosite-icloud",
                    "geosite-apple"
                ],
                "action": "route",
                "outbound": "DIRECT"
            },
            {
                "rule_set": [
                    "geosite-google",
                    "geosite-gfw",
                    "geosite-tld-!cn",
                    "geosite-geolocation-!cn",
                    "geoip-telegram"
                ],
                "action": "route",
                "outbound": "节点选择"
            },
            {
                "rule_set": [
                    "geosite-cn",
                    "geoip-cn",
                    "geoip-private"
                ],
                "action": "route",
                "outbound": "DIRECT"
            }
        ],
        "auto_detect_interface": true,
        "final": "节点选择",
        "default_domain_resolver": {
            "server": "remote"
        },
        "rule_set": [
            {
                "tag": "geosite-category-ads-all",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdmirror.com/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ads-all.srs",
                "update_interval": "24h",
                "download_detour": "节点选择"
            },
            {
                "tag": "geosite-private",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdmirror.com/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs",
                "update_interval": "24h",
                "download_detour": "节点选择"
            },
            {
                "tag": "geosite-icloud",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdmirror.com/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/icloud.srs",
                "update_interval": "24h",
                "download_detour": "节点选择"
            },
            {
                "tag": "geosite-apple",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdmirror.com/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/apple.srs",
                "update_interval": "24h",
                "download_detour": "节点选择"
            },
            {
                "tag": "geosite-google",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdmirror.com/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google.srs",
                "update_interval": "24h",
                "download_detour": "节点选择"
            },
            {
                "tag": "geosite-gfw",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdmirror.com/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/gfw.srs",
                "update_interval": "24h",
                "download_detour": "节点选择"
            },
            {
                "tag": "geosite-tld-!cn",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdmirror.com/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/tld-!cn.srs",
                "update_interval": "24h",
                "download_detour": "节点选择"
            },
            {
                "tag": "geosite-geolocation-!cn",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdmirror.com/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
                "update_interval": "24h",
                "download_detour": "节点选择"
            },
            {
                "tag": "geosite-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdmirror.com/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
                "update_interval": "24h",
                "download_detour": "节点选择"
            },
            {
                "tag": "geoip-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdmirror.com/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
                "update_interval": "24h",
                "download_detour": "节点选择"
            },
            {
                "tag": "geoip-private",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdmirror.com/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/private.srs",
                "update_interval": "24h",
                "download_detour": "节点选择"
            },
            {
                "tag": "geoip-telegram",
                "type": "remote",
                "format": "binary",
                "url": "https://cdn.jsdmirror.com/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/telegram.srs",
                "update_interval": "24h",
                "download_detour": "节点选择"
            }
        ]
    },
    "experimental": {
        "cache_file": {
            "enabled": true,
            "store_fakeip": true,
            "store_rdrc": true
        },
        "clash_api": {
            "default_mode": "海外代理",
            "external_controller": "127.0.0.1:9090",
            "secret": ""
        }
    }
}
